                if (time_ms > 300 && time_ms < 2000) {
                    int bpm = 60000 / time_ms;
                    
                    // 把算好的真实 BPM 发给 Noah 的串口！(自带换行，完美匹配他的 readStringUntil)
                    printf("%d\n", bpm); 
                }
                
                // 算完之后，秒表清零，准备测下一次心跳！
                time_ms = 0; 
                // ==========================================

                // 瞬间反馈：大心
                GPIO_WriteBit(GPIOC, GPIO_Pin_13, Bit_RESET); 
                OLED_Clear(&oled);
                OLED_DrawBitmap(&oled, 128, 64, bitmapheart); 
                OLED_SendBuffer(&oled);
                
                Delay(150); 
                time_ms += 150; 
                time_ms += 40;  // 粗略补偿一下 I2C 驱动 OLED 刷屏花掉的时间

                lastState = 1;
            }
        } 
        else if (sensorValue == 0 && lastState == 1)
        {
            Delay(20);
            time_ms += 20;

            if (GPIO_ReadInputDataBit(GPIOA, GPIO_Pin_1) == 0)
            {
                // 瞬间收缩：小心
                GPIO_WriteBit(GPIOC, GPIO_Pin_13, Bit_SET); 
                OLED_Clear(&oled);
                OLED_DrawBitmap(&oled, 128, 64, bitmapheart_small); 
                OLED_SendBuffer(&oled);
                
                time_ms += 40; // 补偿刷屏时间
                lastState = 0;
            }
        }
        else 
        {
            // 没检测到边缘跳变时，正常走秒表
            Delay(5); 
            time_ms += 5;
            
            // 防护机制：如果你的手离开传感器太久（超过3秒），卡住秒表防止溢出
            if (time_ms > 3000) {
                time_ms = 3000; 
            }
        }
    }  
	}
